<Window x:Class="RAA_WPF_Module2_ProjectSetup.LevelCheckerForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RAA_WPF_Module2_ProjectSetup"
             mc:Ignorable="d" 
             Title="Revit Add-in Academy"
             d:DesignHeight="400" d:DesignWidth="500">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="90"/>
        </Style>
        <Style x:Key="Title" TargetType="Label">
            <Setter Property="FontSize" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Level Checker" Style="{StaticResource Title}"/>
        <Label Grid.Row="1" Content="Select Level to Check"/>
        <ComboBox Grid.Row="2" x:Name="cbxLevel"/>
        <Label Grid.Row="3" Content="Select Mode:"/>
        <StackPanel Orientation="Horizontal" Grid.Row="4">
            <RadioButton x:Name="rbSetColor" Content="Set Color" GroupName="ColorGroup" IsChecked="True"/>
            <RadioButton x:Name="rbReSetColor" Content="Reset Color" GroupName="ColorGroup"/>
        </StackPanel>
        <Label Grid.Row="5" Content="Select Categories to Check"/>
        <StackPanel Orientation="Vertical" Grid.Row="6">
            <CheckBox x:Name="cbWalls" Content="Walls"/>
            <CheckBox x:Name="cbColumns" Content="Columns"/>
            <CheckBox x:Name="cbWindows" Content="Windows"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Right">
            <Button x:Name="btnApply" Content="Apply" Click="btnApply_Click"/>
            <!--<Button x:Name="btnCancel" Content="Cancel" Click="btnCancel_Click"/>-->
        </StackPanel>
    </Grid>
</Window>
